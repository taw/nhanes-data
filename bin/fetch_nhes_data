#!/usr/bin/env ruby
# Fetches all public data files and documentation for the National Health
# Examination Surveys (NHES I 1959-62, NHES II 1963-65, NHES III 1966-70)
# into raw_data/nhes1, raw_data/nhes2, raw_data/nhes3.
#
# File lists are scraped from each survey's CDC page, so anything CDC adds
# there gets picked up. Existing files are skipped unless --force is given.
#
# Usage: bin/fetch_nhes_data [--force] [nhes1 nhes2 nhes3]

require_relative "../lib/fetcher"

Fetcher.run({
  "nhes1" => { page: "https://wwwn.cdc.gov/nchs/nhanes/nhes1/default.aspx", data_dir: "nhes123" },
  "nhes2" => { page: "https://wwwn.cdc.gov/nchs/nhanes/nhes2/default.aspx", data_dir: "nhes123" },
  "nhes3" => { page: "https://wwwn.cdc.gov/nchs/nhanes/nhes3/default.aspx", data_dir: "nhes123" },
}, ARGV)
